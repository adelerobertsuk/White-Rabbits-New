        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님, 여기는 오직 영감을 위한 공간이에요. 리셋을 응원할 뿐, 절대 평가하지 않아요."
          }
        }
      }
    },
