    "circle.header.named" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, this is inspiration only. Cheer a reset. Never weigh it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さん、ここはインスピレーションのための場所です。リセットを応援するだけ。決して測ったりしません。"
