    "circle.header.named" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, this is inspiration only. Cheer a reset. Never weigh it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@さん、ここはインスピレーションのための場所です。リセットを応援するだけ。決して測ったりしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님, 여기는 오직 영감을 위한 공간이에요. 리셋을 응원할 뿐, 절대 평가하지 않아요."
          }
        }
      }
    },
